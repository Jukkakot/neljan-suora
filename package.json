{
  "name": "neljan-suora",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/rules",
    "packages/protocol",
    "packages/neljan-suora-bots",
    "server",
    "client",
    "e2e"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w @neljan-suora/server\" \"npm run dev -w @neljan-suora/client\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint && node tools/kit/check.mjs",
    "e2e": "npm run e2e -w @neljan-suora/e2e",
    "kit:use": "node tools/kit/use.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2"
  }
}
